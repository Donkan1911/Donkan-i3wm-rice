#####################################
### Executed programs and scripts ###
#####################################

# Forces video outputs to have a certain resolution and refresh rate with xrandr
exec_always --no-startup-id xrandr --output HDMI-0 --mode 1920x1080 --rate 180 --output DP-1-1 --mode 1280x1024 --rate 75.02 --left-of HDMI-0

# Starts picom and its config
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf -b

# Disables the X screensaver and DPMS (Display Power Management Signaling)
exec --no-startup-id xset s off -dpms

# Sets the keyboard layout
exec_always --no-startup-id setxkbmap us -variant intl

# Sets the wallpaper with feh after a 0.5 seconds delay
exec_always --no-startup-id sh -c "sleep 0.5 && feh --bg-fill /home/donkan/Images/20260714_134012.jpg"

# Sets the acceleration of the mouse using libinput
exec_always --no-startup-id xinput --set-prop "ROCCAT ROCCAT Kone Pro" "libinput Accel Speed" -0.45

# Mounts USB sticks and external hard drives automatically
exec --no-startup-id udiskie -a

# I forgot what this was for
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

#############
### i3bar ###
#############

# Design of the i3bar workspace selector
bar {
    status_command i3blocks
    colors {
        #                 border  background  text
        focused_workspace  #FFFFFF #FFFFFF #000000
        inactive_workspace #000000 #000000 #FFFFFF
        urgent_workspace   #FF0000 #FF0000 #000000
    }
}

###############
### Windows ###
###############

# Size of gaps between the windows
gaps inner 0
gaps outer 0

# Thickness of the borders of the windows
default_border pixel 1
default_floating_border pixel 1

# Design of the borders of the windows
#                      border  background text indicator child_border                     
client.focused          #FFFFFF #FFFFFF #000000 #FFFFFF #0000FF
client.unfocused        #000000 #000000 #FFFFFF #000000 #000000
client.urgent           #FF0000 #FF0000 #000000 #FF0000 #FF0000

# mod + left-click to move floating windows and mod + right-click to resize them
floating_modifier $mod

# Move tiled windows by either dragging their titlebar, or by holding mod and then left-click and dragging on the windows
tiling_drag modifier titlebar

############
### Font ###
############

# Sets font size and font used for window titles and bar
font pango:monospace 9

############
### Keys ###
############

# Defines variables for the 10 workspace names
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Defines the Windows key as the mod key
set $mod Mod4

###################
### Keybindings ###
###################

# mod + Shift + S to take a screenshot using maim
bindsym $mod+shift+s exec maim -s | xclip -selection clipboard -t image/png

# Use the three media keys (volume up, volume down, mute) to change the volume with pactl in PulseAudio, then sends a signal to i3blocks to refresh the volume block
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && pkill -RTMIN+10 i3blocks
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && pkill -RTMIN+10 i3blocks
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && pkill -RTMIN+10 i3blocks

# mod + Enter to launch the terminal
bindsym $mod+Return exec kitty

# mod + Shift + Q to quit focused window
bindsym $mod+Shift+q kill

# mod + D to launch dmenu
bindsym $mod+d exec --no-startup-id dmenu_run -c -l 10 -nb "#000000" -nf "#FFFFFF" -sb "#FFFFFF" -sf "#000000"

# Change focused window
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# mod + H to split a window horizontally
bindsym $mod+h split h

# mod + V to split a window vertically
bindsym $mod+v split v

# mod + F to toggle fullscreen
bindsym $mod+f fullscreen toggle

# Change the container layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# mod + Shift + space to toggle floating window
bindsym $mod+Shift+space floating toggle

# mod + space to change focus between tiling and floating windows
bindsym $mod+space focus mode_toggle

# I have no idea what "focus parent" means
bindsym $mod+a focus parent

# Switch workspaces
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# mod + Shift + C to reload the configuration file
bindsym $mod+Shift+c reload

# mod + Shift + R to restart i3
bindsym $mod+Shift+r restart

# mod + R to enter resize mode
bindsym $mod+r mode "resize"


# Resize windows (these bindings trigger in resize mode)
mode "resize" {
        # Pressing j or left arrow will shrink the window’s width.
        # Pressing semicolon or right arrow will grow the window’s width.
        # Pressing l or up arrow will shrink the window’s height.
        # Pressing k or down arrow will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # Enter or Escape or $mod + R to go back to normal
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
